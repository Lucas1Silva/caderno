    "fix": "node tools/build.mjs --fix",
    "test": "node --test",
    "bundle": "node tools/build.mjs && node tools/bundle.mjs",
    "evolve": "node tools/evolve.mjs",
    "relatorio": "node tools/relatorio.mjs"
  },
